/// One row per booking. Revenue and volume measures exclude cancelled bookings; dated by arrival (stay) date, with booking-date variants.
table Bookings
	lineageTag: 31ab3a07-ce91-42a1-8ef7-773bfcf4d656
	sourceLineageTag: [fact].[Bookings]

	/// Number of bookings, including cancelled ones. Dated by stay date.
	measure 'Bookings Count' = COUNTROWS(Bookings)
		formatString: #,0
		displayFolder: measures\base\volume
		lineageTag: 370efb0c-42dc-4ed6-ba39-00efd07f0b4d

	/// Rooms reserved on non-cancelled bookings (not multiplied by nights).
	measure 'Rooms Booked' = CALCULATE(SUM(Bookings[RoomsBooked]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: #,0
		displayFolder: measures\base\volume
		lineageTag: 3f615bc3-4555-4391-8b32-56b18e26a9d8

	/// Nights on non-cancelled bookings (not multiplied by rooms).
	measure 'Nights Stayed' = CALCULATE(SUM(Bookings[NightsStayed]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: #,0
		displayFolder: measures\base\volume
		lineageTag: e26bd27e-50aa-4818-962c-146d47c789f0

	/// Room revenue on non-cancelled bookings, dated by arrival date.
	measure 'Room Revenue' = CALCULATE(SUM(Bookings[RoomRevenue]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: 9252babb-adf3-45b6-aa7c-3cb886edb1e0

	/// Experience revenue on non-cancelled bookings.
	measure 'Experience Revenue' = CALCULATE(SUM(Bookings[ExperienceRevenue]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: 40b51eb0-dd37-4c5c-97bd-444c4bdeb8bd

	/// Other non-room, non-experience revenue on non-cancelled bookings.
	measure 'Other Revenue' = CALCULATE(SUM(Bookings[OtherRevenue]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: ea7a0b5d-ce56-4f77-bde8-681d8bc2574c

	/// Discounts given on non-cancelled bookings.
	measure 'Discount Amount' = CALCULATE(SUM(Bookings[DiscountAmount]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: 36ed8438-dcc8-4c71-8e53-23a0b647c526

	/// Cancellation fees kept by the business on cancelled bookings.
	measure 'Cancellation Amount' = SUM(Bookings[CancellationAmount])
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: eeb71bea-cae1-4fa0-95c9-97288d5fcdf9

	/// Room + experience + other revenue on non-cancelled bookings, before discounts.
	measure 'Gross Revenue' = [Room Revenue] + [Experience Revenue] + [Other Revenue]
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: 2803e4e1-a55d-42b6-94bc-3eae3819d4da

	/// Revenue kept: gross revenue less discounts on non-cancelled bookings, plus cancellation fees.
	measure 'Net Revenue' = [Gross Revenue] - [Discount Amount] + [Cancellation Amount]
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: ae720dda-1dc5-4e16-a05e-1161f6a6f3a1

	/// Bookings flagged as cancelled.
	measure 'Cancelled Bookings' = CALCULATE([Bookings Count], Bookings[IsCancelled] = TRUE())
		formatString: #,0
		displayFolder: measures\base\quality
		lineageTag: 5c98c698-251f-4441-b127-4f523bce042a

	/// Bookings not flagged as cancelled.
	measure 'Active Bookings' = CALCULATE([Bookings Count], Bookings[IsCancelled] = FALSE())
		formatString: #,0
		displayFolder: measures\base\quality
		lineageTag: a99ac1d3-3eaf-4edf-80ea-98b009a62a22

	/// Bookings made under the loyalty program.
	measure 'Loyalty Bookings' = CALCULATE([Bookings Count], Bookings[IsLoyaltyBooking] = TRUE())
		formatString: #,0
		displayFolder: measures\base\quality
		lineageTag: aa0791ce-9c0d-4033-86e0-147aefeaeb79

	/// Cancelled bookings as a share of all bookings.
	measure 'Cancellation Rate %' = DIVIDE([Cancelled Bookings], [Bookings Count])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: measures\base\rates
		lineageTag: b17b9234-c82c-488c-80a4-803c76f91a06

	/// Loyalty bookings as a share of all bookings.
	measure 'Loyalty Mix %' = DIVIDE([Loyalty Bookings], [Bookings Count])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: measures\base\rates
		lineageTag: c6f298a7-22fb-4f64-bd50-3b4a841b1a8b

	/// Average nights per non-cancelled booking.
	measure 'Length of Stay' = DIVIDE([Nights Stayed], [Active Bookings])
		formatString: 0.00
		displayFolder: measures\base\rates
		lineageTag: c2168d94-05ec-4eb7-ada2-26d675ac5afc

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["INTEGER_FORMATTING"]}

	/// Net revenue (including cancellation fees) per booking, cancelled bookings included.
	measure 'Net Revenue per Booking' = DIVIDE([Net Revenue], [Bookings Count])
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\rates
		lineageTag: 4d197d13-ceb7-43ec-a377-b00c30433f6c

	/// Bookings counted on the date they were made instead of the stay date.
	measure 'Bookings Count (Booking Date)' = CALCULATE([Bookings Count], USERELATIONSHIP(Bookings[BookingDateKey], 'Date'[DateKey]))
		formatString: #,0
		displayFolder: measures\base\time
		lineageTag: e547bcf3-bd8f-452a-bbfb-6bbd05667a1e

	/// Net revenue counted on the booking date instead of the stay date.
	measure 'Net Revenue (Booking Date)' = CALCULATE([Net Revenue], USERELATIONSHIP(Bookings[BookingDateKey], 'Date'[DateKey]))
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\time
		lineageTag: 44a59422-ce82-4dc2-aee3-8605d2a39bd3

	/// Rooms x nights on non-cancelled bookings.
	measure 'Room Nights Booked' = CALCULATE(SUMX(Bookings, Bookings[RoomsBooked] * Bookings[NightsStayed]), KEEPFILTERS(Bookings[IsCancelled] = FALSE()))
		formatString: #,0
		displayFolder: measures\base\volume
		lineageTag: 419db6ba-60e9-4971-b731-b6b74c476fe1

	/// Non-room revenue: experience revenue plus other revenue.
	measure 'Ancillary Revenue' = [Experience Revenue] + [Other Revenue]
		formatString: $#,0.00;($#,0.00);$0.00
		displayFolder: measures\base\revenue
		lineageTag: c87d120e-cf4b-4fe4-8d84-bc1d929da2d3

	/// Share of gross revenue that comes from experiences and other non-room revenue.
	measure 'Ancillary Mix %' = DIVIDE([Ancillary Revenue], [Gross Revenue])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: measures\base\rates
		lineageTag: 0fb7d246-3163-484b-b670-57e58fc704fc

	/// Discounts as a share of gross revenue.
	measure 'Discount %' = DIVIDE([Discount Amount], [Gross Revenue])
		formatString: #,0.0%;-#,0.0%;#,0.0%
		displayFolder: measures\base\rates
		lineageTag: c567d819-a1be-466d-83c7-2382fdfd9bce

