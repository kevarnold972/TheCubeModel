		formatString: """TRUE"";""TRUE"";""FALSE"""
		displayFolder: attribute
		lineageTag: 98dbfcc2-6b2d-47b1-8a28-a899d61beb4b
		sourceLineageTag: IsCancelled
		summarizeBy: none
		sourceColumn: IsCancelled

